# Copy this file to .env, replace the placeholders, then restart the server.
# Keep .env private; it is ignored by Git.
PORT=3000
# The email address that receives verification/contact notifications.
OWNER_EMAIL=goodluckiyke2010@gmail.com
# The "From" address shown on outgoing emails.
# IMPORTANT: With Brevo, this must be the sender email you verified in your Brevo account.
MAIL_FROM="PressClub <goodluckiyke2010@gmail.com>"
# -------------------------------
# Brevo (Sendinblue) SMTP
# Free tier: 300 emails/day. Works on Render.com free tier.
# 1. Sign up at https://www.brevo.com (free)
# 2. Go to SMTP & API -> SMTP -> discover your SMTP credentials
# 3. SMTP_USER is your Brevo account email
# 4. SMTP_PASS is your Brevo SMTP key (starts with xkeysib-...)
# 5. Verify the sender email/domain in Brevo -> Senders & IP
# -------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=goodluckiyke2010@gmail.com
# Replace with your real Brevo SMTP key (starts with xkeysib-...)
SMTP_PASS=xkeysib-YOUR_BREVO_SMTP_KEY_HERE
