# =====================================================================
# PRESS CLUB – EMAIL CONFIGURATION
# =====================================================================
# Local development:  copy this file to .env, fill in values, restart server.
# 
# DEPLOYMENT (Render.com, Vercel, etc.):
#   The .env file is NEVER committed to Git (see .gitignore).
#   After deploying, you MUST set these values in your hosting dashboard:
#
#   Render.com:
#     Dashboard -> Your Web Service -> Environment -> Environment Variables
#     Add each variable below (or use the render.yaml blueprint which
#     will prompt for them during deployment).
#
#   Vercel:
#     Project Settings -> Environment Variables -> Add
#
#   Netlify:
#     Site settings -> Environment variables -> Add
#
#   After adding, redeploy / restart the service.
# =====================================================================

# Port for the server
PORT=3000

# -----------------------------------------------
# LIVE NEWS FEED (newsdata.io)
# Sign up at https://newsdata.io (free tier exists).
# Copy your API key from the dashboard and paste it below.
# The key is used server-side only — it is never exposed to browsers.
# When empty or the API is down, the site shows sample articles.
# -----------------------------------------------
NEWS_API_KEY=your_newsdata_io_api_key_here

# -----------------------------------------------
# ADVERTISEMENT MONETIZATION
# -----------------------------------------------
# To serve real pay-per-view ads from an external provider:
#   1. Sign up with an ad network that provides a REST API.
#   2. Set ENABLE_ADS_API to 'true'
#   3. Paste your API key below (kept server-side — never sent to browser)
#   4. Set ADS_API_URL to the provider's ad endpoint
# When disabled or when the API is unreachable, the app automatically
# falls back to the local sponsored banner library (ads/tech-summit.svg etc.).
# Impression statistics are persisted in ad_stats.json.
# -----------------------------------------------
ENABLE_ADS_API=false
ADS_API_KEY=your_ad_provider_api_key_here
ADS_API_URL=https://ads.provider.com/v1/banners

# -----------------------------------------------
# AUTOMATED PAYMENTS (Flutterwave) - lets users pay
# online instantly to become payers.
#   1. Sign up at https://dashboard.flutterwave.com (free)
#   2. Get API keys: Settings -> API Keys
#   3. Set FLUTTERWAVE_SECRET_KEY (starts with FLWSECK-...)
#   4. Optional FLUTTERWAVE_PUBLIC_KEY (starts with FLWPUBK-...)
#   5. Set a FLUTTERWAVE_SECRET_HASH in your dashboard
#      (Settings -> Webhooks) and copy the same value here.
#   6. Add webhook URL: https://YOUR-DOMAIN/api/flutterwave-webhook
# When FLUTTERWAVE_SECRET_KEY is empty, the app falls back
# to the manual transfer + owner verification flow.
# -----------------------------------------------
FLUTTERWAVE_SECRET_KEY=FLWSECK-YOUR_SECRET_KEY_HERE
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-YOUR_PUBLIC_KEY_HERE
FLUTTERWAVE_SECRET_HASH=your_secret_hash_for_webhook
# Fixed price (NGN) to become a Payer
PAYMENT_AMOUNT=5000

# Optional: protect the /api/ledger and owner stats detail view with a password.
# If left empty, the ledger is viewable by anyone (only used on the Stats page).
OWNER_PASS=your_private_stats_password

# The email address that receives verification/contact notifications.
OWNER_EMAIL=goodluckiyke2010@gmail.com

# The "From" address shown on outgoing emails.
# IMPORTANT: With Brevo, this must be the sender email you verified in your Brevo account.
MAIL_FROM="PressClub <goodluckiyke2010@gmail.com>"

# -------------------------------
# Brevo (Sendinblue) SMTP
# Free tier: 300 emails/day. Works on Render.com free tier.
# 1. Sign up at https://www.brevo.com (free)
# 2. Go to SMTP & API -> SMTP -> discover your SMTP credentials
# 3. SMTP_USER is your Brevo SMTP login (found in Brevo SMTP & API page)
# 4. SMTP_PASS is your Brevo SMTP key (starts with xsmtpsib-...)
# 5. Verify the sender email/domain in Brevo -> Senders & IP
# -------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=0
# Usually your Brevo account email, or the smtp-brevo.com address Brevo provides
SMTP_USER=b59019001@smtp-brevo.com
# Replace with YOUR REAL Brevo SMTP key (starts with xsmtpsib-...)
# DO NOT commit this to Git! Set it only in .env locally or in Render dashboard.
SMTP_PASS=xsmtpsib-YOUR_BREVO_SMTP_KEY_HERE

# -----------------------------------------------
# OPTIONAL redundant fallback for hosts that block
# outbound SMTP (e.g. Render free tier, Vercel).
# The SMTP key above is for SMTP only and cannot be
# used with the REST API. Get a separate REST API key:
#   Brevo dashboard -> SMTP & API -> API Keys -> 
#   create key "xkeysib-..."
# When set, emails are sent over HTTPS (port 443)
# which works on all hosting providers.
# -----------------------------------------------
BREVO_API_KEY=xkeysib-YOUR_BREVO_REST_API_KEY_HERE